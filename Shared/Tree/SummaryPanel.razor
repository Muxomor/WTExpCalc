@using Microsoft.AspNetCore.Components.Web
@inject ILocalizationService Localization

<div id="summary-container">
    <div id="summary-panel">
        <span class="summary-item summary-rp">
            <span>@Localization.Text(UIStrings.RP):</span> @TotalRp.ToString("N0")
        </span>
        <span class="summary-item summary-sl">
            <span>@Localization.Text(UIStrings.SL):</span> @TotalSl.ToString("N0")
        </span>
        <span class="summary-item summary-limit">
            <span>@Localization.Text(UIStrings.RPLimit):</span>
            <input type="number"
                   class="rp-limit-input"
                   min="1"
                   placeholder="@Localization.Text(UIStrings.Unlimited)"
                   aria-label="@Localization.Text(UIStrings.RPLimit)"
                   value="@RpLimitText"
                   @oninput="e => OnRpLimitInput.InvokeAsync(e)"
                   @onblur="() => OnRpLimitCommit.InvokeAsync()"
                   @onkeydown="e => OnRpLimitKeyDown.InvokeAsync(e)" />
            <span class="limit-suffix">K</span>
        </span>
    </div>

    <div id="selected-names-container">
        <div id="selected-names-panel">
            @if (!string.IsNullOrEmpty(SelectedNames))
            {
                <span title="@SelectedNames">
                    @Localization.Text(UIStrings.Selected): @SelectedNames
                </span>
            }
            else
            {
                <span>&nbsp;</span>
            }
        </div>

        @if (!string.IsNullOrEmpty(SelectedNames))
        {
            <button class="btn btn-sm btn-secondary copy-button"
                    title="@Localization.Text(UIStrings.CopyList)"
                    @onclick="() => OnCopyNames.InvokeAsync()">
                <i class="bi bi-clipboard"></i>
            </button>
            <button class="btn btn-sm btn-info copy-button"
                    title="@Localization.Text(UIStrings.CopyUrl)"
                    @onclick="() => OnCopyUrl.InvokeAsync()"
                    style="margin-left: 5px;">
                <i class="bi bi-link-45deg"></i>
            </button>
            <button class="btn btn-sm copy-button screenshot-button"
                    title="@Localization.Text(UIStrings.DownloadScreenshot)"
                    @onclick="() => OnDownloadScreenshot.InvokeAsync()"
                    disabled="@(!HasSelectedRanks || IsScreenshotInProgress)"
                    style="margin-left: 5px;">
                <i class="bi bi-camera"></i>
            </button>
        }

        @if (CalculatorEnabled)
        {
            <button class="btn btn-sm copy-button calculator-toggle-button @(IsCalculatorOpen ? "active" : "")"
                    title="@Localization.Text(UIStrings.CalculatorTitle)"
                    @onclick="() => OnToggleCalculator.InvokeAsync()"
                    style="margin-left: 5px;">
                <i class="bi bi-calculator"></i>
            </button>
        }
    </div>
</div>

@code {
    [Parameter] public long TotalRp { get; set; }
    [Parameter] public long TotalSl { get; set; }
    [Parameter] public string SelectedNames { get; set; } = string.Empty;
    [Parameter] public string RpLimitText { get; set; } = string.Empty;
    [Parameter] public bool HasSelectedRanks { get; set; }
    [Parameter] public bool IsScreenshotInProgress { get; set; }
    [Parameter] public EventCallback<ChangeEventArgs> OnRpLimitInput { get; set; }
    [Parameter] public EventCallback OnRpLimitCommit { get; set; }
    [Parameter] public EventCallback<KeyboardEventArgs> OnRpLimitKeyDown { get; set; }
    [Parameter] public EventCallback OnCopyNames { get; set; }
    [Parameter] public EventCallback OnCopyUrl { get; set; }
    [Parameter] public EventCallback OnDownloadScreenshot { get; set; }
    [Parameter] public bool CalculatorEnabled { get; set; }
    [Parameter] public bool IsCalculatorOpen { get; set; }
    [Parameter] public EventCallback OnToggleCalculator { get; set; }
}
