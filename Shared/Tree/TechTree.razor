@using WTExpCalc.Models
@inject IExperienceApi Api
@inject IJSRuntime JSRuntime
@inject IUrlStateManager UrlStateManager
@inject NavigationManager Navigation
@inject ILocalizationService Localization
@inject IUiSettingsService UiSettings
@inject TreeSummaryFormatter SummaryFormatter
@implements IAsyncDisposable

<div class="tech-tree-container @LoadingStateCss" id="tech-tree-container-id">
    @if (LoadingState == TreeLoadState.Loading)
    {
        <p>@Localization.Text(UIStrings.Loading)</p>
    }
    else if (LoadingState == TreeLoadState.Error)
    {
        <div class="tree-load-error">
            <p>@_loadErrorMessage</p>
            <button type="button" class="btn btn-primary" @onclick="RetryLoad">@Localization.Text(UIStrings.Retry)</button>
        </div>
    }
    else if (!GridNodes.Any())
    {
        <p>@Localization.Text(UIStrings.NoData)</p>
    }
    else
    {
        <div class="tree-grid" style="@GridStyles">
            @{
                var activeRanks = _layout.ActiveRanks;

                // Отрисовываем только активные ранги
                foreach (var rank in activeRanks)
                {
                    int rowsInThisRank = (MaxRowIndexPerRank.TryGetValue(rank, out var maxRowIndex) ? maxRowIndex : 0) + 1;
                    int startGridRow = 2 + (_layout.RankStartRows.TryGetValue(rank, out var rankStartRow) ? rankStartRow : 0);
                    string rankLabelStyle = $"grid-column: 1; grid-row: {startGridRow} / span {rowsInThisRank};";
                    _layout.RankRequirementsByPrevious.TryGetValue(rank, out var requirement);
                    int selectedCount = _layout.NodesByRank.TryGetValue(rank, out var rankNodes)
                        ? rankNodes.Count(n => n.Type == "vehicle" && _selection.SelectedIds.Contains(n.Id))
                        : 0;

                    <RankLabel Rank="rank"
                               SelectedCount="selectedCount"
                               Requirement="requirement"
                               Style="@rankLabelStyle" />
                }
            }

            @foreach (var node in GridNodes)
            {
                <div @key="node.Id" class="@GetNodeCssClass(node)" style="@GetNodeGridStyle(node)" id="node-container-@node.Id">
                    @if (node.Type == "folder")
                    {
                        <FolderNodeCard Node="node"
                                        IsExpanded="@(currentlyExpandedFolder?.Id == node.Id)"
                                        ContainsSelected="@IsFolderSelected(node)"
                                        Children="@GetVisualNodesInFolderSequence(node)"
                                        SelectedIds="@_selection.SelectedIds"
                                        OnFolderClick="HandleNodeClick"
                                        OnChildClick="ToggleNodeSelection" />
                    }
                    else
                    {
                        <VehicleNodeCard Node="node"
                                         IsSelected="@_selection.IsSelected(node)"
                                         IsRpModified="@_selection.IsRpModified(node)"
                                         EffectiveRp="@_selection.GetEffectiveRp(node)"
                                         OnToggle="@(() => ToggleNodeSelection(node))"
                                         OnRpChanged="@(args => OnRpValueChanged(node, args))" />
                    }
                </div>
            }

            <TreeConnections Dependencies="Dependencies" />
            @{
                var ranksForDividers = _layout.ActiveRanks;
                int standardColumnCount = _layout.StandardColumnCount;
                int premiumDividerColumn = _layout.PremiumDividerColumn;

                int lastDataRow = _layout.LastDataRow;

                //Вертикальный разделитель (Премы)
                var premiumNodesExist = _layout.PremiumColumnCount > 0;
                if (premiumNodesExist && standardColumnCount > 0)
                {
                    string premiumDividerStyle = $"grid-column: {premiumDividerColumn}; grid-row: 2 / {lastDataRow + 1};";
                    <div class="premium-divider-v" style="@premiumDividerStyle"></div>
                }

                //Горизонтальные разделители (только между активными рангами)
                for (int i = 0; i < ranksForDividers.Count - 1; i++)
                {
                    var currentRank = ranksForDividers[i];
                    int rowsInThisRank = (MaxRowIndexPerRank.TryGetValue(currentRank, out var maxRowIdx) ? maxRowIdx : 0) + 1;
                    int startGridRowCurrentRank = 2 + (_layout.RankStartRows.TryGetValue(currentRank, out var rankStartRow) ? rankStartRow : 0);
                    int endGridRowCurrentRank = startGridRowCurrentRank + rowsInThisRank - 1;

                    string rankDividerStyle = $"grid-column: 2 / -1; grid-row: {endGridRowCurrentRank + 1};";
                    <div class="rank-divider-h" style="@rankDividerStyle"></div>
                }
            }

        </div>
        @if (currentlyExpandedFolder != null)
        {
            <div class="folder-popup-overlay" @onclick="CloseFolderPopup"></div>
        }

        @if (currentlyExpandedFolder != null)
        {
            <div class="folder-popup" id="folder-popup-@currentlyExpandedFolder.Id" style="visibility: hidden;" @key="currentlyExpandedFolder.Id" @onclick:stopPropagation="true">
                <div class="folder-popup-content">
                    @foreach (var child in GetVisualNodesInFolderSequence(currentlyExpandedFolder))
                    {
                        if (child.Type == "vehicle")
                        {
                            <div class="folder-popup-item @GetNodeCssClass(child)">
                                <VehicleNodeCard Node="child"
                                                 IsSelected="@_selection.IsSelected(child)"
                                                 IsRpModified="@_selection.IsRpModified(child)"
                                                 EffectiveRp="@_selection.GetEffectiveRp(child)"
                                                 OnToggle="@(() => ToggleNodeSelection(child))"
                                                 OnRpChanged="@(args => OnRpValueChanged(child, args))" />
                            </div>
                        }
                    }
                </div>
            </div>
        }
    }
</div>
