@inherits LayoutComponentBase
@using WTExpCalc.Services
@inject ILocalizationService Localization

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>
    
    <main>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        var saved = await Localization.LoadSavedLanguageAsync();
        await Localization.SetLanguageAsync(saved);
        LocalizationService.PreloadCultures();
    }
}
