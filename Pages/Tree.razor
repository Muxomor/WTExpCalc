@page "/tree/{NationSlug}/{TypeSlug?}"
@using WTExpCalc.Models
@inject ICatalogService Catalog
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@inject IUrlStateManager UrlStateManager
@inject ILocalizationService Localization
@inject IFeatureFlags Features
@implements IDisposable

<h3>@Localization.Text(UIStrings.TechTreeFor) @GetNationDisplayName()</h3>

@if (isLoading)
{
        <p><em>@Localization.Text(UIStrings.LoadingData)</em></p>
}
else if (loadingError != null)
{
        <div class="alert alert-danger" style="background-color: #5a1e1e; border-color: #721c24; color: #f8d7d7;">
            <p>@Localization.Text(UIStrings.Error): @loadingError</p>
            <button class="btn btn-primary" @onclick="RetryLoad">@Localization.Text(UIStrings.Retry)</button>
        </div>
}
else if (vehicleTypes == null || !vehicleTypes.Any())
{
        <p><em>@Localization.Text(UIStrings.NoVehicleTypes)</em></p>
}
else
{
        <ul class="nav nav-tabs tech-type-tabs" data-html2canvas-ignore="true">
        @foreach (var vt in vehicleTypes)
        {
                    <li class="nav-item">
                        <a class="nav-link @(vt.Slug == activeTypeSlug ? "active" : "")"
                           href="/tree/@NationSlug/@vt.Slug">
                    @GetVehicleTypeDisplayName(vt)
                        </a>
                    </li>
        }
        </ul>

        <div class="tab-content mt-3">
        @if (activeTypeId != null && activeNationId != null)
        {
                    <TechTree @ref="techTreeRef" 
                              NationId="activeNationId.Value" 
                              TypeId="activeTypeId.Value" 
                              RpLimit="@GetRpLimit()"
                              OnTotalsUpdated="HandleTotalsUpdate"
                              OnSelectedRanksChanged="HandleSelectedRanksChanged"
                              ScreenshotProgress="HandleScreenshotProgress"
                              ScreenshotCompleted="HandleScreenshotComplete" />
        }
        </div>

        <SummaryPanel TotalRp="currentTotalRp"
                      TotalSl="currentTotalSl"
                      SelectedNames="@selectedVehicleNames"
                      RpLimitText="@rpLimitText"
                      HasSelectedRanks="@hasSelectedRanks"
                      IsScreenshotInProgress="@isScreenshotInProgress"
                      OnRpLimitInput="OnRpLimitInput"
                      OnRpLimitCommit="CommitRpLimit"
                      OnRpLimitKeyDown="OnRpLimitKeyDown"
                      OnCopyNames="CopyNamesToClipboard"
                      OnCopyUrl="CopyUrlToClipboard"
                      OnDownloadScreenshot="DownloadScreenshot"
                      CalculatorEnabled="@Features.CalculatorEnabled"
                      IsCalculatorOpen="@isCalculatorOpen"
                      OnToggleCalculator="ToggleCalculator" />
        @if (Features.CalculatorEnabled)
        {
            <Calculator @ref="calculatorRef" IsOpen="@isCalculatorOpen" ExperienceRp="@currentTotalRp" />
        }
}
<ScreenshotOverlay Visible="@isScreenshotInProgress"
                   Completed="@screenshotCompleted"
                   Succeeded="@screenshotSucceeded"
                   Message="@screenshotProgressMessage" />

@code {
    [Parameter] public string NationSlug { get; set; } = string.Empty;
    [Parameter] public string? TypeSlug { get; set; }

    private TechTree? techTreeRef;
    private List<VehicleType>? vehicleTypes;
    private string? activeTypeSlug;
    private int? activeTypeId;
    private int? activeNationId;
    private Nation? currentNation;
    private long currentTotalRp = 0;
    private long currentTotalSl = 0;
    private string selectedVehicleNames = "";
    private string formattedVehicleText = "";
    private bool isLoading = false;
    private string? loadingError = null;

    private bool hasSelectedRanks = false;
    private bool isScreenshotInProgress = false;
    private bool screenshotCompleted;
    private bool screenshotSucceeded;
    private string screenshotProgressMessage = "";
    private bool isCalculatorOpen;
    private Calculator? calculatorRef;

    private string rpLimitText = "";
    private int? appliedRpLimitK;
    private CancellationTokenSource? rpLimitDebounceCts;
    private CancellationTokenSource? screenshotHideCts;

    protected override async Task OnParametersSetAsync()
    {
        await LoadPageData();
    }

    protected override void OnInitialized()
    {
        Localization.LanguageChanged += OnLanguageChanged;
    }

    private void OnLanguageChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private string GetVehicleTypeDisplayName(VehicleType vt)
    {
        return Localization.VehicleTypeName(vt.Name, vt.NameEnglish);
    }

    private string GetNationDisplayName()
    {
        return currentNation != null ?
               Localization.NationName(currentNation.Name, currentNation.Id) :
               Localization.Text(UIStrings.Loading);
    }

    private void OnRpLimitInput(ChangeEventArgs e)
    {
        rpLimitText = e.Value?.ToString() ?? "";

        if (string.IsNullOrWhiteSpace(rpLimitText))
        {
            ApplyRpLimitK(null);
            return;
        }

        ScheduleRpLimitApply();
    }

    private void ScheduleRpLimitApply()
    {
        rpLimitDebounceCts?.Cancel();
        rpLimitDebounceCts?.Dispose();
        rpLimitDebounceCts = new CancellationTokenSource();
        _ = ApplyRpLimitAfterDelayAsync(rpLimitDebounceCts.Token);
    }

    private async Task ApplyRpLimitAfterDelayAsync(CancellationToken token)
    {
        try
        {
            await Task.Delay(700, token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        await InvokeAsync(ApplyRpLimitFromText);
    }

    private void CommitRpLimit()
    {
        rpLimitDebounceCts?.Cancel();
        ApplyRpLimitFromText();
    }

    private void ApplyRpLimitFromText()
    {
        if (string.IsNullOrWhiteSpace(rpLimitText))
        {
            ApplyRpLimitK(null);
            return;
        }

        if (!int.TryParse(rpLimitText, out var limitK) || limitK < 1)
        {
            // Не применяем мусор, возвращаем последнее корректное значение.
            rpLimitText = appliedRpLimitK?.ToString() ?? "";
            StateHasChanged();
            return;
        }

        ApplyRpLimitK(limitK);
    }

    private void ApplyRpLimitK(int? limitK)
    {
        if (appliedRpLimitK == limitK)
        {
            return;
        }

        appliedRpLimitK = limitK;
        StateHasChanged();
    }

    private long? GetRpLimit()
    {
        return appliedRpLimitK.HasValue ? appliedRpLimitK.Value * 1000L : null;
    }

    private void ToggleCalculator()
    {
        isCalculatorOpen = !isCalculatorOpen;
    }

    private void OnRpLimitKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            CommitRpLimit();
        }
    }
    private async Task LoadPageData()
    {
        try
        {
            isLoading = true;
            loadingError = null;
            StateHasChanged();

            // Загружаем нацию по slug
            currentNation = await Catalog.GetNationBySlugAsync(NationSlug);
            if (currentNation == null)
            {
                loadingError = Localization.Text(UIStrings.NationNotFound, NationSlug);
                return;
            }

            activeNationId = currentNation.Id;

            // Загружаем типы техники
            vehicleTypes = await Catalog.GetVehicleTypesAsync();
            if (vehicleTypes == null || !vehicleTypes.Any())
            {
                loadingError = Localization.Text(UIStrings.VehicleTypesLoadFailed);
                return;
            }

            var firstType = vehicleTypes.FirstOrDefault(vt => GameDataLocalization.IsValidVehicleTypeSlug(vt.Slug));
            if (firstType == null)
            {
                loadingError = Localization.Text(UIStrings.VehicleTypesLoadFailed);
                return;
            }

            // Определяем активный тип техники
            if (!string.IsNullOrEmpty(TypeSlug))
            {
                var requestedType = vehicleTypes.FirstOrDefault(
                    vt => vt.Slug.Equals(TypeSlug, StringComparison.OrdinalIgnoreCase));

                if (requestedType != null)
                {
                    activeTypeSlug = requestedType.Slug;
                    activeTypeId = requestedType.Id;
                }
                else
                {
                    Navigation.NavigateTo($"/tree/{NationSlug}/{firstType.Slug}", replace: true);
                    return;
                }
            }
            else
            {
                // Перенаправляем на первый доступный тип
                Navigation.NavigateTo($"/tree/{NationSlug}/{firstType.Slug}", replace: true);
                return;
            }

            // Сбрасываем данные при смене параметров
            selectedVehicleNames = "";
            formattedVehicleText = "";
            currentTotalRp = 0;
            currentTotalSl = 0;
            hasSelectedRanks = false;
            isCalculatorOpen = false;
            calculatorRef?.Reset();
        }
        catch (Exception ex)
        {
            loadingError = Localization.Text(UIStrings.DataLoadError, ex.Message);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task RetryLoad()
    {
        await LoadPageData();
    }

    private async Task CopyUrlToClipboard()
    {
        await UrlStateManager.CopyCurrentUrlToClipboardAsync();
    }

    private async Task CopyNamesToClipboard()
    {
        // Используем отформатированный текст вместо обычного списка имен
        if (string.IsNullOrEmpty(formattedVehicleText))
        {
            return;
        }

        try
        {
            await JSRuntime.InvokeVoidAsync("techTreeFunctions.copyTextToClipboard_fallback", formattedVehicleText);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error copying names to clipboard: {ex.Message}");
        }
    }

    private async Task DownloadScreenshot()
    {
        if (techTreeRef == null || !hasSelectedRanks || isScreenshotInProgress) return;

        screenshotCompleted = false;
        screenshotSucceeded = false;
        screenshotHideCts?.Cancel();

        try
        {
            isScreenshotInProgress = true;
            screenshotProgressMessage = Localization.Text(UIStrings.PreparingScreenshot);
            StateHasChanged();

            await techTreeRef.DownloadScreenshot();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error downloading screenshot: {ex.Message}");
            screenshotCompleted = true;
            screenshotSucceeded = false;
            screenshotProgressMessage = Localization.Text(UIStrings.ScreenshotError);
            ScheduleScreenshotOverlayHide(2500);
        }
        finally
        {
            if (!screenshotCompleted)
            {
                isScreenshotInProgress = false;
                StateHasChanged();
            }
        }
    }

    private void HandleScreenshotProgress(string message)
    {
        screenshotProgressMessage = message;
        InvokeAsync(StateHasChanged);
    }

    private void HandleScreenshotComplete(ScreenshotResult result)
    {
        screenshotCompleted = true;
        screenshotSucceeded = result.Success;
        screenshotProgressMessage = result.Message;
        StateHasChanged();

        ScheduleScreenshotOverlayHide(result.Success ? 1600 : 2500);
    }

    private void ScheduleScreenshotOverlayHide(int delayMs)
    {
        screenshotHideCts?.Cancel();
        screenshotHideCts?.Dispose();
        screenshotHideCts = new CancellationTokenSource();
        _ = HideScreenshotOverlayAfterDelayAsync(delayMs, screenshotHideCts.Token);
    }

    private async Task HideScreenshotOverlayAfterDelayAsync(int delayMs, CancellationToken token)
    {
        try
        {
            await Task.Delay(delayMs, token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        isScreenshotInProgress = false;
        screenshotCompleted = false;
        StateHasChanged();
    }

    private void HandleTotalsUpdate(TotalsUpdateEventArgs args)
    {
        currentTotalRp = args.TotalRp;
        currentTotalSl = args.TotalSl;
        selectedVehicleNames = args.SelectedNames; // Для отображения на экране
        formattedVehicleText = args.FormattedText;  // Для копирования
        StateHasChanged(); // Обновляем UI после получения новых данных
    }

    private void HandleSelectedRanksChanged(List<int> selectedRanks)
    {
        hasSelectedRanks = selectedRanks != null && selectedRanks.Any();
        StateHasChanged();
    }

    public void Dispose()
    {
        rpLimitDebounceCts?.Cancel();
        rpLimitDebounceCts?.Dispose();
        screenshotHideCts?.Cancel();
        screenshotHideCts?.Dispose();
        Localization.LanguageChanged -= OnLanguageChanged;
    }
}