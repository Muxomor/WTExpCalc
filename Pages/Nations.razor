@page "/"
@using WTExpCalc.Models
@inject ICatalogService Catalog
@inject ILocalizationService Localization
@implements IDisposable

<h3>@Localization.Text(UIStrings.SelectNation)</h3>

@if (loadError != null)
{
        <div class="alert alert-danger" style="background-color: #5a1e1e; border-color: #721c24; color: #f8d7d7;">
            <p>@Localization.Text(UIStrings.Error): @loadError</p>
            <button class="btn btn-primary" @onclick="ReloadData">@Localization.Text(UIStrings.Retry)</button>
        </div>
}
else if (nations == null)
{
        <p><em>@Localization.Text(UIStrings.Loading)</em></p>
}
else if (nations.Count == 0)
{
        <p><em>@Localization.Text(UIStrings.NoNationsAvailable)</em></p>
}
else
{
        <div class="row">
        @foreach (var n in nations)
        {
                    <div class="col-6 col-md-4 col-lg-3 mb-4">
                        <a class="card h-100 nation-card text-decoration-none"
                           href="@($"/tree/{n.Slug}")"
                           style="cursor:pointer; color:inherit;">
                            <img src="@n.ImageUrl"
                                 class="card-img-top p-3"
                                 alt="@GetNationDisplayName(n)" 
                                 style="height:120px; object-fit:contain;" />
                            <div class="card-footer text-center">
                                <strong>@GetNationDisplayName(n)</strong>
                            </div>
                        </a>
                    </div>
        }
        </div>
}

@code {
    private List<Nation>? nations;
    private string? loadError;

    protected override async Task OnInitializedAsync()
    {
        Localization.LanguageChanged += OnLanguageChanged;
        await LoadData();
    }

    private void OnLanguageChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private string GetNationDisplayName(Nation nation)
    {
        return Localization.NationName(nation.Name, nation.Id);
    }

    private async Task LoadData()
    {
        loadError = null;

        try
        {
            nations = await Catalog.GetNationsAsync();
        }
        catch (Exception ex)
        {
            nations = null;
            loadError = Localization.Text(UIStrings.DataLoadError, ex.Message);
        }
    }

    private async Task ReloadData()
    {
        nations = null;
        StateHasChanged();
        await LoadData();
    }

    public void Dispose()
    {
        Localization.LanguageChanged -= OnLanguageChanged;
    }
}
